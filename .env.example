# Federation dev config file in docker/dev-config/
CONFIG_FILE=config.sunet.php
APP_PORT=8080
# smtp4dev web UI (all outgoing mail is caught here)
SMTP4DEV_PORT=8025
BASE_URL=http://localhost:8080/
APP_MODE=Lab
DB_NAME=metadata
DB_USER=metadata_admin
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# comma separated eduPersonPrincipalNames with admin level
ADMIN_USERS=admin@example.org
# Fake SSO login for /admin (development only, leave empty behind real SSO)
DEV_EPPN=admin@example.org

# Load the federation metadata (IdPs/SPs) into the database on first start
SEED_METADATA=1
# 1 = reimport entities even if the database already has some
SEED_FORCE=0
# 1 = import every entity of the aggregate, not only those registered by this federation
SEED_ALL=0
